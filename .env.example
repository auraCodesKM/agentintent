GEMINI_API_KEY=
# Switch models by changing only these two lines. Defaults are the two
# free-tier models with 500 requests/day quota on this key; the 20/day
# tiers (gemini-3.6-flash etc.) burn out almost immediately — see HANDOFF.md.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# GEMINI_RPM=13 # optional global pacing (requests/minute); eval runner sets 13
GOOGLE_GENAI_USE_VERTEXAI=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
DATABASE_URL="file:./dev.db"
# DATABASE_URL=postgres://... (Neon pooled connection string, for deploy — see docs/DEPLOY.md)
WEBHOOK_FORCE_FAIL=false
